#!/bin/bash
# ============================================================
#  music-tool — 加密音乐一键解密/分类/清理工具 v2.0
#  用法: music-tool <命令> [参数]
# ============================================================
set -euo pipefail

VERSION="2.0.0"
TOOL_DIR="$HOME/.music-tool"
UNLOCK_PY="$TOOL_DIR/unlock.py"
MUSIC_LIB="$HOME/personal/music"
REPORT_FILE="$TOOL_DIR/last-report.txt"

# === 颜色 ===
RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'
BOLD='\033[1m'; NC='\033[0m'

ok()  { echo -e "  ${GREEN}✓${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $1"; }
info() { echo -e "  ${BLUE}ℹ${NC} $1"; }
header() { echo -e "\n${BOLD}═══ $1 ═══${NC}"; }
section() { echo -e "\n${BOLD}── $1 ──${NC}"; }

# ============================================================
# 帮助
# ============================================================
usage() {
  cat <<EOF
${BOLD}music-tool v${VERSION}${NC} — 加密音乐一键处理

${BOLD}用法:${NC}
  music-tool setup              初始化环境（首次使用）
  music-tool decrypt <目录>      解密目录中的加密音乐
  music-tool classify <目录>     对已解密的音乐按曲风分类
  music-tool check <目录>        检查音质/异常文件
  music-tool all <目录>          一键执行：解密→分类→检查
  music-tool report             查看最近一次处理报告
  music-tool clean              清理临时文件

${BOLD}示例:${NC}
  music-tool all ~/Downloads/qqmusic     # 一键处理整个目录
  music-tool decrypt ~/Downloads/songs   # 仅解密
  music-tool check ~/personal/music      # 检查已整理的音乐库

${BOLD}支持的加密格式:${NC}
  QQ音乐: .mflac .mgg .mggl .qmc* .mflach .bkc* .tm*
  网易云: .ncm .uc
  酷狗: .kgm .kgma .vpr  酷我: .kwm
  虾米: .xm  咪咕: .mg3d  喜马拉雅: .x2m .x3m
EOF
}

# ============================================================
# 环境初始化
# ============================================================
do_setup() {
  header "初始化 music-tool 环境"
  mkdir -p "$TOOL_DIR"

  # 检查依赖
  section "检查依赖"
  for cmd in python3 node; do
    if command -v $cmd &>/dev/null; then
      ok "$cmd: $(command -v $cmd)"
    else
      fail "$cmd 未安装 — 请先安装"
    fi
  done

  # 安装 Node.js 依赖（WASM 解密模块）
  section "解密引擎"
  if [ -d "$TOOL_DIR/node_modules/@xhacker/qmcwasm" ]; then
    ok "WASM 解密模块已就绪"
  else
    info "安装 WASM 解密模块..."
    cd "$TOOL_DIR"
    if [ ! -f "$TOOL_DIR/package.json" ]; then
      npm init -y --silent 2>/dev/null
    fi
    npm install @xhacker/qmcwasm @xhacker/kgmwasm --save 2>&1 | tail -3
    ok "WASM 解密模块安装完成"
  fi

  # 验证 WASM 桥接脚本
  if [ -f "$TOOL_DIR/wasm_bridge.js" ]; then
    ok "WASM 桥接脚本已就绪"
  else
    fail "WASM 桥接脚本缺失 — 请重新安装 music-tool"
  fi

  # 创建默认目录结构
  section "音乐库目录"
  for d in "加密文件" "解密失败" "异常文件" "儿童音乐" "DJ-电音" \
           "长途驾驶-经典怀旧" "长途驾驶-轻松旅途" "华语流行" "古风国风" \
           "欧美流行" "民谣慢歌" "摇滚乐队" "影视原声" "情歌对唱" \
           "网络热歌" "流行热歌" "经典老歌"; do
    mkdir -p "$MUSIC_LIB/$d"
  done
  ok "音乐库目录已创建: $MUSIC_LIB"

  echo ""
  ok "初始化完成！现在可以使用: music-tool all <目录>"
}

# ============================================================
# 解密
# ============================================================
do_decrypt() {
  local src_dir="${1:-}"
  if [ -z "$src_dir" ]; then
    echo -e "${RED}错误: 请指定源目录${NC}"
    echo "用法: music-tool decrypt <目录>"
    exit 1
  fi

  if [ ! -d "$src_dir" ]; then
    echo -e "${RED}错误: 目录不存在: $src_dir${NC}"
    exit 1
  fi

  local work_dir="/tmp/music-tool-$$"
  local decrypted_dir="$work_dir/decrypted"
  local failed_dir="$MUSIC_LIB/解密失败"
  local encrypted_archive="$MUSIC_LIB/加密文件"

  mkdir -p "$decrypted_dir" "$failed_dir" "$encrypted_archive"

  header "解密: $src_dir"

  # 统计源文件
  local total_encrypted=$(find "$src_dir" -type f \( \
    -iname "*.mflac" -o -iname "*.mgg" -o -iname "*.mggl" \
    -o -iname "*.qmc0" -o -iname "*.qmc3" -o -iname "*.qmcflac" -o -iname "*.qmcogg" \
    -o -iname "*.ncm" -o -iname "*.kgm" -o -iname "*.kgma" -o -iname "*.vpr" \
    -o -iname "*.kwm" -o -iname "*.xm" -o -iname "*.x2m" -o -iname "*.x3m" \
    -o -iname "*.tm0" -o -iname "*.tm2" -o -iname "*.tm3" -o -iname "*.tm6" \
    -o -iname "*.mmp4" -o -iname "*.mg3d" -o -iname "*.mflach" \
    -o -iname "*.bkcmp3" -o -iname "*.bkcflac" -o -iname "*.bkcwav" \
    -o -iname "*.bkcogg" -o -iname "*.bkcwma" -o -iname "*.bkcape" -o -iname "*.bkcm4a" \
    -o -iname "*.tkm" -o -iname "*.uc" -o -iname "*.uc!" \
  \) 2>/dev/null | wc -l | tr -d ' ')
  info "找到 $total_encrypted 个加密文件"

  if [ "$total_encrypted" -eq 0 ]; then
    warn "没有找到加密文件"
    return
  fi

  # 调用 Python 解密引擎
  python3 "$UNLOCK_PY" decrypt "$src_dir" "$decrypted_dir" --failed-dir "$failed_dir"

  # 统计结果
  local total_ok=$(find "$decrypted_dir" -type f 2>/dev/null | wc -l | tr -d ' ')
  local total_failed=$(find "$failed_dir" -type f ! -name '.DS_Store' 2>/dev/null | wc -l | tr -d ' ')

  # 清理失败文件夹中的缓存碎片
  section "清理缓存碎片"
  local cleaned=0
  find "$failed_dir" -type f \( -name 'AIM*' -o -name 'F0M*' -o -name 'D0M*' \
    -o -name 'DTM*' -o -name '[0-9]*-[0-9]*.mgg' -o -name '[0-9]*-[0-9]*.mflac' \) \
    -delete 2>/dev/null && cleaned=1 || true
  local failed_real=$(find "$failed_dir" -type f ! -name '.DS_Store' 2>/dev/null | wc -l | tr -d ' ')
  [ "$cleaned" -eq 1 ] && ok "已清理缓存碎片，剩余: $failed_real 首"

  # 移动原加密文件到存档
  find "$src_dir" -type f \( \
    -iname "*.mflac" -o -iname "*.mgg" -o -iname "*.mggl" \
    -o -iname "*.qmc0" -o -iname "*.qmc3" -o -iname "*.qmcflac" -o -iname "*.qmcogg" \
    -o -iname "*.ncm" -o -iname "*.kgm" -o -iname "*.kgma" -o -iname "*.vpr" \
    -o -iname "*.kwm" -o -iname "*.xm" -o -iname "*.x2m" -o -iname "*.x3m" \
    -o -iname "*.tm0" -o -iname "*.tm2" -o -iname "*.tm3" -o -iname "*.tm6" \
    -o -iname "*.mmp4" -o -iname "*.mg3d" -o -iname "*.mflach" \
  \) -exec mv {} "$encrypted_archive/" \; 2>/dev/null || true

  # 清理空目录
  find "$src_dir" -type d -empty -delete 2>/dev/null || true

  # 生成报告
  {
    echo "========================================="
    echo "  music-tool 解密报告"
    echo "  时间: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "  源目录: $src_dir"
    echo "========================================="
    echo ""
    echo "📊 统计:"
    echo "  源加密文件: $total_encrypted 个"
    echo "  成功解密:   $total_ok 首"
    echo "  解密失败:   $failed_real 首"
    echo ""
    echo "📁 输出位置:"
    echo "  解密成功: $decrypted_dir"
    echo "  解密失败: $failed_dir"
    echo "  加密存档: $encrypted_archive"
  } | tee "$REPORT_FILE"

  echo ""
  ok "解密完成! 解密文件位于: $decrypted_dir"
  info "报告已保存: $REPORT_FILE"
}

# ============================================================
# 分类
# ============================================================
do_classify() {
  local src_dir="${1:-}"
  if [ -z "$src_dir" ]; then
    echo -e "${RED}错误: 请指定源目录${NC}"
    exit 1
  fi

  header "分类: $src_dir"
  python3 "$TOOL_DIR/classify.py" "$src_dir" "$MUSIC_LIB" 2>/dev/null || {
    warn "分类脚本未就绪，使用简单分类..."
    _simple_classify "$src_dir"
  }

  find "$src_dir" -type d -empty -delete 2>/dev/null || true
  echo ""
  ok "分类完成!"
}

_simple_classify() {
  local src="$1"
  # 简单按文件名关键词分类
  find "$src" -type f \( -iname "*.mp3" -o -iname "*.flac" -o -iname "*.ogg" -o -iname "*.m4a" -o -iname "*.wav" \) | while read f; do
    local base=$(basename "$f")
    local dest="$MUSIC_LIB/华语流行/"
    case "$base" in
      *[Dd][Jj]*|*[Rr]emix*|*混音*|*电音*|*慢摇*|*劲爆*) dest="$MUSIC_LIB/DJ-电音/" ;;
      *儿歌*|*宝宝*|*童谣*|*幼儿园*|*贝瓦*|*贝乐虎*) dest="$MUSIC_LIB/儿童音乐/" ;;
      *古风*|*国风*|*戏腔*) dest="$MUSIC_LIB/古风国风/" ;;
      *周杰伦*|*陈奕迅*|*许巍*|*张学友*|*刘德华*|*Beyond*|*beyond*) dest="$MUSIC_LIB/经典老歌/" ;;
      *民谣*|*吉他*|*赵雷*|*马頔*|*宋冬野*|*陈粒*) dest="$MUSIC_LIB/民谣慢歌/" ;;
      *摇滚*|*乐队*) dest="$MUSIC_LIB/摇滚乐队/" ;;
      *电视剧*|*电影*|*OST*|*原声*|*主题曲*|*片尾曲*) dest="$MUSIC_LIB/影视原声/" ;;
    esac
    mkdir -p "$dest"
    mv "$f" "$dest/" 2>/dev/null || true
  done
}

# ============================================================
# 质量检查
# ============================================================
do_check() {
  local target="${1:-$MUSIC_LIB}"
  local anomaly_dir="$MUSIC_LIB/异常文件"

  header "质量检查: $target"
  mkdir -p "$anomaly_dir"

  local checked=0 moved=0

  find "$target" -type f \( -iname "*.flac" -o -iname "*.mp3" -o -iname "*.ogg" \
    -o -iname "*.wav" -o -iname "*.m4a" -o -iname "*.aac" \) \
    ! -path "*/加密文件/*" ! -path "*/解密失败/*" ! -path "*/异常文件/*" 2>/dev/null | while read f; do
    checked=$((checked + 1))
    base=$(basename "$f")
    size=$(stat -f%z "$f" 2>/dev/null || echo 0)
    problem=0
    reason=""

    # 检查1: <2MB
    if [ "$size" -lt 2097152 ] 2>/dev/null; then
      problem=1; reason="文件过小($((size/1024))KB)"
    fi

    # 检查2: <1分钟
    if [ "$problem" -eq 0 ] && command -v ffprobe &>/dev/null; then
      dur=$(ffprobe -v quiet -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null || echo "")
      if [ -n "$dur" ] && [ "$dur" != "N/A" ]; then
        dur_sec="${dur%.*}"
        if [ "$dur_sec" -lt 60 ] 2>/dev/null; then
          problem=1; reason="时长过短(${dur_sec}秒)"
        fi
      fi
    fi

    # 检查3: hash/cache命名
    if [ "$problem" -eq 0 ]; then
      if echo "$base" | grep -qiE '^[A-Z0-9]{8,}[-.][0-9]+\.(mp3|flac|ogg|m4a)$'; then
        problem=1; reason="疑似缓存碎片"
      fi
    fi

    if [ "$problem" -eq 1 ]; then
      dest="$anomaly_dir/$base"
      [ -f "$dest" ] && dest="$anomaly_dir/$(echo $RANDOM)_$base"
      mv "$f" "$dest" 2>/dev/null && \
        echo "  ⚠ $reason: $(dirname "$f" | xargs basename)/$base"
    fi
  done

  local anomaly_count=$(find "$anomaly_dir" -type f ! -name '.DS_Store' 2>/dev/null | wc -l | tr -d ' ')
  echo ""
  info "异常文件: $anomaly_count 首 → $anomaly_dir"
}

# ============================================================
# 一键全流程
# ============================================================
do_all() {
  local src_dir="${1:-}"
  if [ -z "$src_dir" ]; then
    echo -e "${RED}错误: 请指定源目录${NC}"
    exit 1
  fi

  header "🎵 music-tool 全流程处理"
  echo "  源目录: $src_dir"
  echo "  音乐库: $MUSIC_LIB"
  echo ""

  # 1. 解密
  do_decrypt "$src_dir"

  # 2. 分类
  local decrypted="/tmp/music-tool-$$/decrypted"
  if [ -d "$decrypted" ] && [ "$(find "$decrypted" -type f 2>/dev/null | wc -l | tr -d ' ')" -gt 0 ]; then
    do_classify "$decrypted"
  fi

  # 3. 检查
  do_check "$MUSIC_LIB"

  # 4. 清理
  rm -rf "/tmp/music-tool-$$" 2>/dev/null || true

  echo ""
  header "✅ 全流程完成!"
  echo "  音乐库: $MUSIC_LIB"

  # 各文件夹统计
  for d in "$MUSIC_LIB"/*/; do
    local count=$(find "$d" -type f ! -name '.DS_Store' 2>/dev/null | wc -l | tr -d ' ')
    [ "$count" -gt 0 ] && printf "    %-26s %4s 首\n" "$(basename "$d")" "$count"
  done
}

# ============================================================
# 报告
# ============================================================
do_report() {
  if [ -f "$REPORT_FILE" ]; then
    cat "$REPORT_FILE"
  else
    warn "暂无报告，请先执行 music-tool decrypt 或 music-tool all"
  fi
}

# ============================================================
# 清理
# ============================================================
do_clean() {
  header "清理临时文件"
  rm -rf /tmp/music-tool-* 2>/dev/null && ok "临时目录已清理" || info "无临时文件"
  rm -rf "$TOOL_DIR/tmp" 2>/dev/null && ok "引擎临时文件已清理" || true
}

# ============================================================
# 主入口
# ============================================================
main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    setup)    do_setup "$@" ;;
    decrypt)  do_decrypt "$@" ;;
    classify) do_classify "$@" ;;
    check)    do_check "$@" ;;
    all)      do_all "$@" ;;
    report)   do_report ;;
    clean)    do_clean ;;
    -h|--help|help) usage ;;
    *)
      echo -e "${RED}未知命令: $cmd${NC}"
      usage
      exit 1
      ;;
  esac
}

main "$@"
