#!/bin/bash
# ============================================================
#  music-tool — 加密音乐解密工具 v3.0
#  仅用于解密。输入目录 → 输出目录,不扫描/不分类/不改动音乐库。
#  用法: music-tool <命令> [参数]
# ============================================================
set -euo pipefail

VERSION="3.0.0"
TOOL_DIR="$HOME/.music-tool"
UNLOCK_PY="$TOOL_DIR/unlock.py"

# === 颜色(用 $'...' 确保 echo 与 heredoc 都能正确渲染) ===
RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BLUE=$'\033[34m'
BOLD=$'\033[1m'; NC=$'\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $1"; }
info() { echo -e "  ${BLUE}ℹ${NC} $1"; }
header() { echo -e "\n${BOLD}═══ $1 ═══${NC}"; }
section() { echo -e "\n${BOLD}── $1 ──${NC}"; }

# ============================================================
# 帮助
# ============================================================
usage() {
  cat <<EOF
${BOLD}music-tool v${VERSION}${NC} — 加密音乐解密工具(纯解密)

${BOLD}用法:${NC}
  music-tool setup                       初始化环境(首次使用)
  music-tool decrypt <输入目录> [输出目录] [选项]
  music-tool rename <目录> [--dry-run]   按歌曲元数据批量重命名

${BOLD}选项:${NC}
  --cookie '<qqmusic_key=...>'   QQ 音乐登录 cookie(解密 QQ 新格式 musicex 必需)
  --cookie-file <路径>            从文件读取 cookie
  --failed-dir <目录>             失败文件拷贝到此目录
  --qq-db <路径>                  指定本地 qqmusic.sqlite(默认自动检测)

${BOLD}示例:${NC}
  # 解密其他平台 / QQ 旧格式(内嵌密钥,无需 cookie)
  music-tool decrypt ~/Downloads/songs ~/Music/out

  # 解密含 QQ 新格式(musicex/QMCv2),需登录 cookie
  music-tool decrypt ~/Downloads/qq ~/Music/out --cookie 'qqmusic_key=XXXX'

  # 按歌曲元数据重命名(预览模式)
  music-tool rename ~/Music/songs --dry-run

  # 按歌曲元数据重命名(正式执行)
  music-tool rename ~/Music/songs

${BOLD}如何获取 cookie:${NC}
  浏览器登录 https://y.qq.com → F12 → Application → Cookies → 复制 qqmusic_key 的值。
  仅用于解密你自己账号可访问的音乐。

${BOLD}支持的加密格式:${NC}
  QQ音乐: .mflac .mgg .mggl .qmc* .mflach .bkc* .tm*  (含 musicex/QMCv2 新格式)
  网易云: .ncm .uc   酷狗: .kgm .kgma .vpr   酷我: .kwm
  虾米: .xm   咪咕: .mg3d   喜马拉雅: .x2m .x3m
EOF
}

# ============================================================
# 环境初始化(仅安装解密依赖)
# ============================================================
do_setup() {
  header "初始化 music-tool 环境"
  mkdir -p "$TOOL_DIR"

  section "检查依赖"
  for cmd in python3 node; do
    if command -v $cmd &>/dev/null; then
      ok "$cmd: $(command -v $cmd)"
    else
      fail "$cmd 未安装 — 请先安装"
    fi
  done

  # numpy 可选(加速 MAP 解密)
  if python3 -c "import numpy" 2>/dev/null; then
    ok "numpy: 已安装(MAP 解密加速)"
  else
    info "numpy 未安装(可选;pip install numpy 可加速大文件解密)"
  fi

  section "WASM 解密模块(QQ 旧格式 / 酷狗)"
  if [ -d "$TOOL_DIR/node_modules/@xhacker/qmcwasm" ]; then
    ok "WASM 解密模块已就绪"
  else
    info "安装 WASM 解密模块..."
    cd "$TOOL_DIR"
    [ -f "$TOOL_DIR/package.json" ] || npm init -y --silent 2>/dev/null
    npm install @xhacker/qmcwasm @xhacker/kgmwasm --save 2>&1 | tail -3
    ok "WASM 解密模块安装完成"
  fi

  [ -f "$TOOL_DIR/wasm_bridge.js" ] && ok "WASM 桥接脚本已就绪" \
    || fail "WASM 桥接脚本缺失 — 请重新安装 music-tool"

  echo ""
  ok "初始化完成!用法: music-tool decrypt <输入目录> <输出目录>"
}

# ============================================================
# 解密(输入目录 → 输出目录,不改动其他任何文件)
# ============================================================
do_decrypt() {
  local src_dir="" out_dir="" extra=()

  # 解析参数:前两个非选项参数是 输入/输出 目录,其余原样透传给 unlock.py
  while [ $# -gt 0 ]; do
    case "$1" in
      --cookie|--cookie-file|--failed-dir|--qq-db)
        extra+=("$1" "${2:-}"); shift 2 ;;
      --*)
        extra+=("$1"); shift ;;
      *)
        if [ -z "$src_dir" ]; then src_dir="$1"
        elif [ -z "$out_dir" ]; then out_dir="$1"
        fi
        shift ;;
    esac
  done

  if [ -z "$src_dir" ]; then
    echo -e "${RED}错误: 请指定输入目录${NC}"
    echo "用法: music-tool decrypt <输入目录> [输出目录] [选项]"
    exit 1
  fi
  if [ ! -d "$src_dir" ]; then
    echo -e "${RED}错误: 目录不存在: $src_dir${NC}"
    exit 1
  fi
  # 默认输出到 输入目录/decrypted
  [ -z "$out_dir" ] && out_dir="${src_dir%/}/decrypted"
  mkdir -p "$out_dir"

  header "解密: $src_dir → $out_dir"
  python3 "$UNLOCK_PY" decrypt "$src_dir" "$out_dir" ${extra:+"${extra[@]}"}

  echo ""
  ok "完成。解密文件位于: $out_dir"
}

# ============================================================
# 重命名(按歌曲元数据重命名音频文件)
# ============================================================
do_rename() {
  local target_dir=""
  local extra=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) extra+=("$1"); shift ;;
      *)
        if [ -z "$target_dir" ]; then target_dir="$1"
        fi
        shift ;;
    esac
  done

  if [ -z "$target_dir" ]; then
    echo -e "${RED}错误: 请指定目录${NC}"
    echo "用法: music-tool rename <目录> [--dry-run]"
    exit 1
  fi
  if [ ! -d "$target_dir" ]; then
    echo -e "${RED}错误: 目录不存在: $target_dir${NC}"
    exit 1
  fi

  header "按元数据重命名: $target_dir"
  python3 "$UNLOCK_PY" rename "$target_dir" ${extra:+"${extra[@]}"}
}

# ============================================================
# 主入口
# ============================================================
main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    setup)         do_setup "$@" ;;
    decrypt)       do_decrypt "$@" ;;
    rename)        do_rename "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo -e "${RED}未知命令: $cmd${NC}"
      usage
      exit 1
      ;;
  esac
}

main "$@"
